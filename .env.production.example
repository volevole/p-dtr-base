# .env.production.example
# Это шаблон для создания .env.production при переезде на новый сервер для проекта
# Скопируйте этот файл в .env.production и заполните своими значениями
NODE_ENV=production
REACT_APP_API_MODE=remote
REACT_APP_USE_REMOTE_SERVER=true
REACT_APP_YANDEX_DISK_MODE=curl
REACT_APP_YANDEX_PREVIEW_SIZE=M
REACT_APP_API_URL=https://your-domain.com
DISABLE_ESLINT_PLUGIN=true