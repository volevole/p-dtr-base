# .env.remote
# ‘ронт на локале, бек на проде

# –ежим API: remote (удаленный сервер)
REACT_APP_API_MODE=remote

# —тарый параметр (дл¤ обратной совместимости)
REACT_APP_USE_REMOTE_SERVER=true

# –Режим работы с яндекс.ƒиском: legacy, embed, direct, curl
REACT_APP_YANDEX_DISK_MODE=embed
REACT_APP_YANDEX_PREVIEW_SIZE=M

# API URL (используетс¤ только если REACT_APP_API_MODE не задан)
REACT_APP_API_URL=https://p-dtr-base.onrender.com