# .env.development
# Локальная разработка (фронт + бек на локале)

# Режим API: local (локальный сервер) или remote (удаленный)
REACT_APP_API_MODE=local

# Старый параметр (для обратной совместимости)
REACT_APP_USE_REMOTE_SERVER=false

# Режим работы с Яндекс.Диском: legacy, embed, direct
REACT_APP_YANDEX_DISK_MODE=embed
REACT_APP_YANDEX_PREVIEW_SIZE=M

# API URL (используется только если REACT_APP_API_MODE не задан)
REACT_APP_API_URL=http://localhost:3001