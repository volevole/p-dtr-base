# .env.production
# Продакшен сборка

NODE_ENV=production

# Режим API: remote (удаленный сервер)
REACT_APP_API_MODE=remote

# Старый параметр (для обратной совместимости)
REACT_APP_USE_REMOTE_SERVER=true

# Режим работы с Яндекс.Диском: legacy, embed, direct
# Режим работы с Яндекс.Диском: legacy, embed, direct
#// Режимы:
#// 'embed' - редирект на Яндекс (для локала)
#// 'legacy' - старый прокси (с обновлением ссылок)  
#// 'curl' - новый прокси через curl (для продакшена)
REACT_APP_YANDEX_DISK_MODE=curl
# похоже на рег.ру надо legacy (Прокси), а не embed  (редирект)
REACT_APP_YANDEX_PREVIEW_SIZE=M

# API URL (используется только если REACT_APP_API_MODE не задан)
# REACT_APP_API_URL=https://p-dtr-base.onrender.com
REACT_APP_API_URL=http://194.226.165.244 
#:3001
# REACT_APP_API_URL=  # пусто — относительные запросы

# Отключаем ESLint плагин (опционально)
DISABLE_ESLINT_PLUGIN=true